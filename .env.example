# Server
PORT=4005
NODE_ENV=development

# Proveedor IA por defecto ("gemini" | "openai")
DEFAULT_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=openai

# API Keys de Proveedores IA
GEMINI_API_KEY=tu_gemini_api_key_aqui
OPENAI_API_KEY=tu_openai_api_key_aqui

# Modelos configurables
GEMINI_CHAT_MODEL=gemini-2.5-flash
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_EMBEDDING_MODEL=text-embedding-004
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# Supabase (Vector Store + Sesiones)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Guardrails & Cuotas por Sesión
MAX_MESSAGES_PER_SESSION=25
MAX_FILES_PER_SESSION=3
MAX_FILE_SIZE_MB=4
SLIDING_WINDOW_MESSAGES=6
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Bucket privado de Supabase Storage donde se guardan los originales de las cotizaciones
COTIZACIONES_BUCKET=cotizaciones-mia

# Microservicio interno de búsqueda de hoteles (solo lectura: /locations/search, /hotels/search)
HOTEL_SERVICE_URL=http://localhost:3001
